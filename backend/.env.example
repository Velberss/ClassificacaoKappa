PORT=5000
NODE_ENV=development

# Local development uses SQLite. Render production uses DATABASE_URL instead.
DATABASE_PATH=./db/kappa.sqlite
# DATABASE_URL=
DATABASE_SSL=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

CORS_ORIGIN=http://localhost:5173
EXCEL_DATA_PATH=../data/excel

# Required only when NODE_ENV=production and running seed:users.
EVALUATOR_1_PASSWORD=
EVALUATOR_2_PASSWORD=
EVALUATOR_3_PASSWORD=
EVALUATOR_4_PASSWORD=
